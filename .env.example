# ==========================================
# WhatsApp Real Estate AI Agent Configuration
# ==========================================

# Port for Web Dashboard
PORT=3000

# AI Provider: 'gemini' | 'openai' | 'groq' | 'ollama'
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional if using Groq for ultra-fast Llama 3)
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama URL (Optional if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# Auto-Reply Default Status (true or false)
AUTO_REPLY_ENABLED=true

# Notification Settings (Optional - send instant Telegram notification on serious buyer appointment)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
